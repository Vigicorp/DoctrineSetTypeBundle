{
    "name": "okapon/doctrine-set-type-bundle",
    "type": "symfony-bundle",
    "description": "Provides support of MySQL SET type for Doctrine2 in Symfony2 applications.",
    "keywords": ["bundle", "symfony", "doctrine", "MySQL", "SET", "type", "DBAL"],
    "homepage": "https://github.com/okapon/DoctrineSetTypeBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuichi Okada",
            "email": "yuuichi177@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/dependency-injection": "^7.0|^8.0",
        "symfony/config": "^7.0|^8.0",
        "symfony/http-kernel": "^7.0|^8.0",
        "symfony/form": "^7.0|^8.0",
        "symfony/validator": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0",
        "symfony/doctrine-bridge": "^7.0|^8.0",
        "symfony/translation": "^7.0|^8.0",
        "doctrine/orm": "~2.3|^3.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phake/phake": ">=2.0.0@dev"
    },
    "autoload": {
        "psr-4": {
            "Okapon\\DoctrineSetTypeBundle\\": ""
        }
    }
}
